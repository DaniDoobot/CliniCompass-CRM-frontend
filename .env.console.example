# ============================================================
# Variables de entorno — Consola de Mensajes (Doobot + Meta)
# ============================================================
# Añadir estas variables al .env del proyecto clinicompass-suite-main.
# ⚠️  Estas son credenciales de DEMO/DESARROLLO.
#     NO usar tokens reales de Meta Graph API aquí.
#     En producción mover a Edge Functions (ver plan Fase 4).
# ============================================================

# --- Doobot ---
# URL de la instancia de doobot. Las llamadas van proxadas via Vite en dev.
# En producción configurar proxy Nginx o Edge Function.
VITE_DOOBOT_USER=admin
VITE_DOOBOT_PASS=admin

# ID de la consola en doobot (aparece como "Console" en las peticiones)
# Cambiar por el ID real de la cuenta de producción.
VITE_DOOBOT_CONSOLE_ID=conversaciones-demo

# --- Meta / WhatsApp Cloud API ---
# ⚠️  SOLO DEMO. En producción este token debe ir en el servidor, nunca en el frontend.
# Phone ID del número de WhatsApp Business registrado en Meta.
VITE_DOOBOT_META_PHONE_ID=
# Bearer token de Meta Graph API (permanente o de larga duración).
# DEJAR VACÍO hasta tener el token real. Con valor vacío, el envío de mensajes fallará
# pero la consola de lectura puede funcionar si doobot tiene su propio token configurado.
VITE_DOOBOT_META_TOKEN=
