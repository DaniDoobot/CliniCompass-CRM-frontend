############################################################
# CliniCompass — Supabase Self-Hosted Environment Variables
# Copia este archivo a .env.docker y rellena los valores
############################################################

# ─── PostgreSQL ────────────────────────────────────────────
# Contraseña para el usuario postgres. Mínimo 16 caracteres.
POSTGRES_PASSWORD=cambia-esta-contrasena-segura

# ─── JWT ───────────────────────────────────────────────────
# Secret para firmar tokens JWT. Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 32
JWT_SECRET=lRq9O3V4khmUBHBZyA1isjpmSQvAyuHXIUJuP/NI8ms=

# SECRET_KEY_BASE para Realtime (genera con: openssl rand -base64 64)
SECRET_KEY_BASE=tu-secret-key-base-de-64-caracteres

# ─── API Keys (JWTs firmados con JWT_SECRET) ───────────────
# Genera en: https://supabase.com/docs/guides/self-hosting#api-keys
# O usa: npx @supabase/cli keys generate
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── URLs ──────────────────────────────────────────────────
# URL pública donde corre el API Gateway Kong
API_EXTERNAL_URL=http://localhost:8000
# URL del frontend (para redirects de auth)
SITE_URL=http://localhost:5173
# URLs adicionales permitidas en auth redirects (separadas por comas)
ADDITIONAL_REDIRECT_URLS=

# ─── Dashboard (Supabase Studio) ───────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia-esta-contrasena-admin

# ─── SMTP (para emails de auth) ────────────────────────────
# Si no tienes SMTP, pon GOTRUE_MAILER_AUTOCONFIRM=true en docker-compose
# y los usuarios no necesitarán confirmar email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_ADMIN_EMAIL=tu-email@gmail.com

# ─── OpenAI (para Edge Functions de IA) ────────────────────
OPENAI_API_KEY=sk-...

############################################################
# Variables para el FRONTEND (.env)
# Después de levantar el stack, actualiza el .env del proyecto:
#
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_PUBLISHABLE_KEY=<mismo valor que ANON_KEY>
############################################################
